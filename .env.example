# ─────────────────────────────────────────────────────────────────────────────
# MailForge — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your real .env to version control.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM (required) ───────────────────────────────────────────────────────────
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use. Options (free tier):
#   llama-3.1-8b-instant   ← fast, good quality  (default)
#   llama-3.1-70b-versatile ← slower, higher quality
LLM_MODEL=llama-3.1-8b-instant

# 0 = deterministic output. Range: 0.0 – 1.0
LLM_TEMPERATURE=0


# ── Company details (used in every generated email) ───────────────────────────
COMPANY_NAME=Your Company Name
FOUNDER_NAME=Your Name
COMPANY_DESCRIPTION=a leading technology consulting company


# ── Portfolio ─────────────────────────────────────────────────────────────────
# Path to your portfolio CSV (relative to project root)
PORTFOLIO_FILE=data/portfolio.csv

# Optional: hard-code up to 2 portfolio links to always include in emails.
# Leave blank to let the app auto-select based on job skills.
PORTFOLIO_LINK_1=
PORTFOLIO_LINK_2=

# Maximum portfolio links to include per email
MAX_PORTFOLIO_LINKS=2


# ── Server ────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8080


# ── App behaviour ─────────────────────────────────────────────────────────────
# "development" → detailed errors, Swagger UI enabled, auto-reload
# "production"  → errors hidden from client, Swagger UI disabled
ENV=development

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Seconds to wait for a page to load before timing out
SCRAPE_TIMEOUT=15
